{
  "config": {
    "step": {
      "user": {
        "title": "Ferroamp Cloud Control",
        "description": "Log in with the account you use in the Ferroamp app. The password is used once and not stored; Home Assistant keeps the login token Ferroamp hands out. The prefix must match the one EMS reads (default 'ferroamp').",
        "data": {
          "email": "E-mail",
          "password": "Password",
          "prefix": "Entity prefix"
        }
      },
      "facility": {
        "title": "Choose the system",
        "description": "The account can see more than one Ferroamp system.",
        "data": {
          "facility_id": "System"
        }
      },
      "reauth_confirm": {
        "title": "Log in to Ferroamp again",
        "description": "Ferroamp no longer accepts the stored login. Log in again with the account you use in the Ferroamp app.",
        "data": {
          "email": "E-mail",
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_auth": "Ferroamp refused the login. Check the e-mail and password; an account that signs in with Apple or Google only has no password for this login.",
      "cannot_connect": "Could not reach Ferroamp's cloud.",
      "no_facilities": "The account has no Ferroamp system."
    },
    "abort": {
      "already_configured": "This system is already set up.",
      "reauth_successful": "Logged in again."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Ferroamp Cloud Control",
        "menu_options": {
          "settings": "Settings",
          "rebuild_page": "Build the Ferroamp page anew"
        }
      },
      "settings": {
        "title": "Settings",
        "data": {
          "scan_interval": "Poll interval",
          "show_page": "Show the Ferroamp page in the sidebar"
        },
        "data_description": {
          "scan_interval": "How often power, the state of charge and the configuration in force are read from Ferroamp's cloud. Schedules and today's energy are read every ten minutes whatever this says.",
          "show_page": "The page with every value and an explanation for each. Off takes this system off the page, and the page out of the sidebar when no system is left on it."
        }
      },
      "rebuild_page": {
        "title": "Build the Ferroamp page anew",
        "description": "Takes the page out of the sidebar and puts it back, with a new address for its cards so that every browser loads them afresh. Useful after an update, or when the page looks wrong. Nothing about the system changes. A browser with the page open may need to be reloaded once."
      }
    },
    "abort": {
      "page_rebuilt": "The Ferroamp page has been built anew. Reload the browser once if it still looks the same.",
      "page_hidden": "The page is switched off for every system, so there is nothing to build. Switch it on under Settings first."
    }
  },
